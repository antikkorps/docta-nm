POSTGRES_USER=docta
# openssl rand -hex 32  (hex: no URL-unsafe chars, the password also goes in DATABASE_URL)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docta
# Host port, bound to 127.0.0.1 only. 5432 is often taken by another local Postgres.
POSTGRES_PORT=5442
# Must repeat the password and POSTGRES_PORT above: .env does not expand variables.
DATABASE_URL=postgresql://docta:change-me@127.0.0.1:5442/docta
